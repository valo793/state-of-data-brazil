<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="architecture" name="AWS Big Data Pipeline">
    <mxGraphModel dx="1546" dy="1007" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- S3 Data Lake Group -->
        <mxCell id="s3_group" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;dashed=1;dashPattern=8 8;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" value="Amazon S3 Data Lake (Camadas Medallion)" vertex="1">
          <mxGeometry height="300" width="560" x="200" y="80" as="geometry" />
        </mxCell>
        
        <!-- Camada Bronze -->
        <mxCell id="s3_bronze" parent="s3_group" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#cd7f32;strokeColor=#8b4513;fontColor=#ffffff;fontStyle=1" value="Camada Bronze&#xa;(Dados Brutos Catalogados)" vertex="1">
